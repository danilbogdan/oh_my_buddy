server {
    server_name danilbogdan.com www.danilbogdan.com;

    root /var/www/danilbogdan.com;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/danilbogdan.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/danilbogdan.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    server_name buddy.danilbogdan.com;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    } 

    location /src/ {
        root /home/danilyuk_bogdan_polska/oh_my_buddy;
    }

    location /admin {
        proxy_pass http://0.0.0.0:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /telegrambot {
        proxy_pass http://unix:/tmp/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    } 


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/danilbogdan.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/danilbogdan.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = www.danilbogdan.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = danilbogdan.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name danilbogdan.com www.danilbogdan.com;
    return 404; # managed by Certbot




}

server {
    if ($host = buddy.danilbogdan.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name buddy.danilbogdan.com;
    return 404; # managed by Certbot


}